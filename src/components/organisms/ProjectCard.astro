---
import ProjectLabel from "../atoms/ProjectLabel.astro";
import ProjectTitle from "../molecules/ProjectTitle.astro";
import ProjectLink from "../molecules/ProjectLink.astro";

interface Props {
  category: string;
  technology: string;
  title: string;
  href: string;
  direction: "left" | "right";
  speed: number;
}

const { category, technology, title, href, direction, speed } = Astro.props;
---

<div class="home__projects__project group/project text-boulder">
  <ProjectLabel category={category} technology={technology} />

  <a
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    class="group/link pointer-events-none fine:pointer-events-auto"
  >
    <ProjectTitle title={title} direction={direction} speed={speed} />
  </a>

  <ProjectLink href={href} />
</div>
