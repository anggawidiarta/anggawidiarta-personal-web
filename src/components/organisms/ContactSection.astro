---
import Quote from "../atoms/Quote.astro";
import Line from "../atoms/Line.astro";
import MarqueeText from "../molecules/MarqueeText.astro";
import EmailButton from "../atoms/EmailButton.astro";

const CONTACT_EMAIL = "anggawidiarta55@gmail.com";
const MARQUEE_TEXT =
  "LET'S TALK — LET'S COLLABORATE — SAY HELLO — WANNA BE STARTING SOMETHING?";
const QUOTE_TEXT =
  "In any moment of decision, the best thing you can do is the right thing, the next best thing is the wrong thing, and the worst thing you can do is nothing.";
const EMAIL_LINK = `mailto:${CONTACT_EMAIL}?subject=Lets%20work%20together!&body=Hello%2C%20I%20think%20we%20need%20you%20to%20work%20on%2Fcollaborate%20this%20particular%20product...%20Reach%20out%20as%20soon%20as%20you%20can.`;
---

<section class="over-tablet:pt-[12rem]">
  <Quote
    text={QUOTE_TEXT}
    className="mb-[6.4rem] hidden px-[4rem] font-georgia text-[1.6rem] leading-[1.3] font-normal capitalize italic max-sm:text-justify md:block tablet:text-[3rem] over-phone:mx-auto over-phone:max-w-[44rem] over-phone:p-0 over-phone:text-center phone:px-[1.6rem] phone:text-[16px]"
  />

  <Line position="left" />

  <MarqueeText text={MARQUEE_TEXT} emailLink={EMAIL_LINK} />

  <Line position="right" />

  <EmailButton email={CONTACT_EMAIL} />
</section>
