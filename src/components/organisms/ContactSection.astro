---
import { getProfile, mailtoLink } from "../../lib/site";
import Line from "../atoms/Line.astro";
import MarqueeText from "../molecules/MarqueeText.astro";
import EmailButton from "../atoms/EmailButton.astro";

const profile = await getProfile();
const emailLink = mailtoLink(profile);
---

<section class="over-tablet:pt-[12rem]">
  <Line position="left" />

  <MarqueeText text={profile.marquee_text} emailLink={emailLink} />

  <Line position="right" />

  <EmailButton email={profile.contact_email} emailLink={emailLink} />
</section>
