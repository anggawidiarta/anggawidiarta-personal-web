---
import { buttonClass } from "../utils/classes";
import ButtonLabel from "./atoms/ButtonLabel.astro";
import NowPlaying from "./molecules/NowPlaying.astro";

const socials = [
  { label: "INSTAGRAM", href: "https://www.instagram.com/anggawdyrta/" },
  { label: "GITHUB", href: "https://github.com/anggawidiarta" },
  { label: "LINKEDIN", href: "https://www.linkedin.com/in/anggawidiarta/" },
  { label: "iCodeThis", href: "https://icodethis.com/anggawidiarta" },
];
---

<footer
  class="relative ml-auto flex w-full max-w-[40rem] flex-col gap-[3.2rem] pb-[4.8rem] text-[16px] font-normal over-tablet:ml-0 over-tablet:grid over-tablet:max-w-none over-tablet:grid-cols-2 over-tablet:items-start over-tablet:gap-x-[2.4rem] over-tablet:gap-y-[3.2rem] wide:grid-cols-[1fr_auto_1fr] over-tablet:px-[2.4rem] over-tablet:pb-[2.4rem] phone:max-w-[255px]"
  id="js-footer"
>
  <div
    class="order-3 flex font-sauce over-tablet:order-2 over-tablet:pt-[8px] wide:order-1"
  >
    <a
      href="https://homeiswhereyourbagis.com/en/15-things-you-should-see-on-lombok/"
      target="_blank"
      rel="noopener noreferrer nofollow"
      class="mr-[1.4rem] cursor-pointer text-boulder transition-colors duration-500 ease-[ease] hover:text-gold"
      >LOMBOK, INDONESIA</a
    >
    <div
      class="relative before:absolute before:left-0 before:h-full before:w-[6px] before:bg-ink"
    >
      <a
        class="clock24"
        id="tz24-1708652367-c1765-eyJob3VydHlwZSI6IjI0Iiwic2hvd2RhdGUiOiIwIiwic2hvd3NlY29uZHMiOiIwIiwic2hvd3RpbWV6b25lIjoiMCIsInR5cGUiOiJkIiwibGFuZyI6ImVuIn0="
        title="time now"
        target="_blank"
        rel="noopener noreferrer nofollow"></a>
    </div>
  </div>

  <div
    class="order-1 flex flex-wrap gap-[0.8rem] over-tablet:order-1 over-tablet:col-span-2 over-tablet:flex-nowrap over-tablet:justify-center wide:order-2 wide:col-span-1"
  >
    {
      socials.map(({ label, href }) => (
        <a
          href={href}
          target="_blank"
          rel="noopener noreferrer"
          class={buttonClass}
        >
          <ButtonLabel text={label} />
        </a>
      ))
    }
  </div>

  <NowPlaying
    layout="row"
    className="order-2 over-tablet:order-3 over-tablet:justify-self-end wide:self-center"
  />
</footer>
