---
import { buttonClass, linkChildren } from "../utils/classes";
import { cn } from "../utils/cn";
import ButtonLabel from "./atoms/ButtonLabel.astro";

const socials = [
  { label: "INSTAGRAM", href: "https://www.instagram.com/anggawdyrta/" },
  { label: "GITHUB", href: "https://github.com/anggawidiarta" },
  { label: "LINKEDIN", href: "https://www.linkedin.com/in/anggawidiarta/" },
  { label: "iCodeThis", href: "https://icodethis.com/anggawidiarta" },
];
---

<footer
  class="relative w-full max-w-[40rem] justify-center ml-auto text-[16px] font-normal over-tablet:ml-0 over-tablet:flex over-tablet:max-w-none phone:max-w-[255px]"
  id="js-footer"
>
  <div>
    <div class="items-center tablet:mb-[4.8rem] over-tablet:flex">
      <div
        class="ml-auto flex w-full max-w-[40rem] phone:max-w-[255px] over-tablet:w-auto over-tablet:max-w-none"
      >
        <div class="flex flex-wrap gap-[0.8rem] over-tablet:ml-[0.8rem]">
          {
            socials.map(({ label, href }) => (
              <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                class={buttonClass}
              >
                <ButtonLabel text={label} />
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>
  <div
    class="flex max-w-fit font-sauce over-tablet:absolute over-tablet:top-[1rem] over-tablet:right-0 over-tablet:left-[2.4rem]"
  >
    <a
      href="https://homeiswhereyourbagis.com/en/15-things-you-should-see-on-lombok/"
      target="_blank"
      rel="noopener noreferrer nofollow"
      class="mr-[1.4rem] cursor-pointer text-boulder transition-colors duration-500 ease-[ease] hover:text-gold"
      >LOMBOK, INDONESIA</a
    >
    <div
      class="relative before:absolute before:left-0 before:h-full before:w-[6px] before:bg-ink tablet:mb-[2.4rem]"
    >
      <a
        class="clock24"
        id="tz24-1708652367-c1765-eyJob3VydHlwZSI6IjI0Iiwic2hvd2RhdGUiOiIwIiwic2hvd3NlY29uZHMiOiIwIiwic2hvd3RpbWV6b25lIjoiMCIsInR5cGUiOiJkIiwibGFuZyI6ImVuIn0="
        title="time now"
        target="_blank"
        rel="noopener noreferrer nofollow"></a>
    </div>
  </div>
  <p
    class={cn(
      linkChildren,
      "over-tablet:absolute over-tablet:top-[1rem] over-tablet:right-[2.4rem]"
    )}
  >
    Created by{" "}
    <a
      href="https://www.instagram.com/anggawdyrta/"
      target="_blank"
      rel="noopener noreferrer nofollow"
    >
      Angga Widiarta
    </a>
  </p>
</footer>
