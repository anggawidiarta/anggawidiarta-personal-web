---
import { getProjects } from "../../lib/site";
import { paddingHome } from "../../utils/classes";
import ProjectLine from "../atoms/ProjectLine.astro";
import ProjectCard from "../organisms/ProjectCard.astro";

const projects = await getProjects();
const pad = (n: number) => String(n).padStart(2, "0");
---

<section class={paddingHome}>
  {
    projects.map(({ title, category, technology, url, year }, index) => {
      const fromLeft = index % 2 === 0;
      return (
        <>
          <ProjectLine position={fromLeft ? "right" : "left"} />
          <ProjectCard
            title={title}
            category={category}
            technology={technology}
            href={url}
            index={`${pad(index + 1)} / ${pad(projects.length)}`}
            year={year}
            direction={fromLeft ? "left" : "right"}
            speed={fromLeft ? -8 : 8}
          />
        </>
      );
    })
  }
  <ProjectLine position="right" />
</section>
