---
import { buttonClass } from "../../utils/classes";
import ButtonLabel from "../atoms/ButtonLabel.astro";

interface Props {
  href: string;
}

const { href } = Astro.props;
---

<div class="project__link pr-[5rem] pb-[3.1rem] text-right over-phone:hidden">
  <a href={href} target="_blank" rel="noopener noreferrer" class={buttonClass}>
    <ButtonLabel text="VIEW SITE" />
  </a>
</div>
