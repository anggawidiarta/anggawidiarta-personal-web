---
import LogoMark from "../atoms/LogoMark.astro";
import NavText from "../atoms/NavText.astro";
import NowPlaying from "./NowPlaying.astro";

const currentYear = new Date().getFullYear();
---

<div
  class="mr-[5rem] w-full max-w-[49rem] justify-between uppercase over-phone:flex phone:mr-[2rem] phone:max-w-none"
>
  <div class="min-w-0">
    <NavText>
      <a
        href="/"
        aria-label="I Putu Angga Purnama Widiarta, home"
        class="group/logo flex items-center gap-[12px] transition-colors duration-300 fine:hover:text-gold"
      >
        <LogoMark />
        <span>
          I Putu Angga <br />
          Purnama Widiarta
        </span>
      </a>
    </NavText>

    <NowPlaying className="mt-[2.4rem]" />
  </div>

  <NavText className="text-boulder phone:hidden">
    <span>
      Fullstack Developer <br />
      Portfolio / {currentYear}
    </span>
  </NavText>
</div>
