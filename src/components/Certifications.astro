---
import { getCertifications, getExperiences, getProfile } from "../lib/site";
import { desc12, desc16, paddingHome } from "../utils/classes";
import { cn } from "../utils/cn";
import ProjectLine from "./atoms/ProjectLine.astro";

const [experiences, certifications, { interests }] = await Promise.all([
  getExperiences(),
  getCertifications(),
  getProfile(),
]);

const sectionTitle = cn(desc12, "awards__title mb-[24px] text-boulder");
const row =
  "grid grid-cols-[minmax(0,1fr)_auto] items-baseline gap-x-[2.4rem] border-t-2 border-boulder py-[16px]";
const primary = cn(desc16, "block text-ash transition-colors duration-200");
const secondary = cn(desc12, "mt-[4px] block text-boulder uppercase");
const contentTitle = cn(desc12, "mb-[2.4rem] text-boulder uppercase");
const contentDesc = cn(
  desc16,
  "w-full max-w-[95rem] text-pretty leading-[1.45] tracking-[-0.01em]",
);
---

<section
  class={cn(
    paddingHome,
    "home__awards mx-auto max-w-[113rem] py-[9.6rem] over-tablet:py-[14rem]",
  )}
>
  <h2 class={sectionTitle}>
    <span>WORK EXPERIENCE</span>
  </h2>
  <ol class="list-none p-0">
    {
      experiences.map(({ role, organization, period }, index) => (
        <li>
          <ProjectLine position={index % 2 === 0 ? "left" : "right"} />
          <div class="grid gap-x-[2.4rem] gap-y-[1.2rem] py-[3.2rem] over-tablet:grid-cols-[minmax(0,1fr)_max(24rem,190px)] phone:py-[2.4rem]">
            <h3 class="overflow-hidden font-bebas text-[max(40px,6.4rem)] leading-[0.95] tracking-[-0.025em] text-balance text-boulder uppercase phone:text-[40px] phone:leading-[1]">
              <span class="block" data-rise>
                {role}
              </span>
            </h3>
            <p class="pt-[0.8rem] over-tablet:text-right" data-fade-in>
              <span class={cn(desc16, "block text-ash")}>{organization}</span>
              {period && (
                <span
                  class={cn(
                    desc12,
                    "mt-[4px] block text-boulder uppercase tabular-nums",
                  )}
                >
                  {period}
                </span>
              )}
            </p>
          </div>
        </li>
      ))
    }
    <li aria-hidden="true">
      <ProjectLine position={experiences.length % 2 === 0 ? "left" : "right"} />
    </li>
  </ol>

  <div class="mt-[9.6rem] justify-between over-tablet:flex">
    {
      certifications.length > 0 && (
        <div class="mb-[9.6rem] over-tablet:mb-0 over-tablet:w-full over-tablet:max-w-[max(55.5rem,30rem)]">
          <h2 class={sectionTitle}>
            <span>CERTIFICATIONS</span>
          </h2>
          <ul class="list-none p-0">
            {certifications.map(({ name, issuer, year, credential_url }) => {
              const meta = [issuer, year].filter(Boolean).join(" · ");
              const body = (
                <span>
                  <span
                    class={cn(
                      primary,
                      credential_url && "fine:group-hover/cert:text-gold",
                    )}
                  >
                    {name}
                  </span>
                  {meta && <span class={secondary}>{meta}</span>}
                </span>
              );
              return (
                <li data-fade-in>
                  {credential_url ? (
                    <a
                      href={credential_url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class={cn(row, "group/cert")}
                    >
                      {body}
                      <svg
                        aria-hidden="true"
                        viewBox="0 0 24 24"
                        width="16"
                        height="16"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="text-boulder transition-[color,translate] duration-300 ease-[cubic-bezier(0.25,1,0.5,1)] fine:group-hover/cert:translate-x-[2px] fine:group-hover/cert:-translate-y-[2px] fine:group-hover/cert:text-gold"
                      >
                        <path d="M7 17 17 7M8 7h9v9" />
                      </svg>
                      <span class="sr-only">
                        (view credential, opens in a new tab)
                      </span>
                    </a>
                  ) : (
                    <div class={row}>{body}</div>
                  )}
                </li>
              );
            })}
          </ul>
        </div>
      )
    }

    {
      interests && (
        <div class="over-tablet:w-full over-tablet:max-w-[max(32.5rem,18rem)]">
          <div data-fade-in>
            <h2 class={contentTitle}>Interests</h2>
            <p class={contentDesc}>{interests}</p>
          </div>
        </div>
      )
    }
  </div>
</section>
