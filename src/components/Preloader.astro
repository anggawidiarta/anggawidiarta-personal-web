---
const bars = Array.from({ length: 7 }, (_, i) => i);

// Staggered delay per bar; the second group is shifted by half the animation duration.
const barDelay = (group: number, bar: number) => {
  const stagger = group === 1 && bar === 0 ? 0.001 : bar * 0.02;
  return `calc(var(--s) * -${stagger}${group === 1 ? " - var(--s) / 2" : ""})`;
};

const groups = [
  "animate-mirror-1",
  "animate-mirror-2 [transform:rotate(90deg)_rotateX(180deg)]",
];
---

<div
  class="wrapper absolute z-9999 flex h-screen w-screen items-center justify-center overflow-hidden bg-ink [--s:2s] [scrollbar-width:none]"
>
  <div
    class="flex h-[50vmin] w-[50vmin] flex-col items-center justify-center overflow-hidden text-center [perspective:1000vmin]"
  >
    {
      groups.map((groupClass, group) => (
        <div
          class={`absolute h-full w-full px-[3vmin] py-[6.5vmin] ${groupClass}`}
        >
          {bars.map((bar) => (
            <div
              class="my-[2vmin] h-[3vmin] w-[44vmin] animate-bar-grow bg-[linear-gradient(90deg,#fff0_33%,var(--color-gold)_33%_67%,#fff0_67%_100%)] [background-position-x:-203%] bg-size-[300%]"
              style={`animation-delay: ${barDelay(group, bar)}`}
            />
          ))}
        </div>
      ))
    }
  </div>
</div>
