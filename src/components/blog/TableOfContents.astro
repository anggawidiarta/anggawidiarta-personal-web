---
import { desc12 } from "../../utils/classes";
import { cn } from "../../utils/cn";

interface Props {
  headings: { depth: number; slug: string; text: string }[];
}

const items = Astro.props.headings.filter(({ depth }) => depth === 2 || depth === 3);

const link =
  "block py-[6px] text-boulder transition-colors duration-300 aria-[current=location]:text-ash fine:hover:text-gold";
---

{
  items.length > 0 && (
    <>
      <nav aria-label="Contents" class="hidden over-tablet:block">
        <p class={cn(desc12, "mb-[1.6rem] text-boulder uppercase")}>
          Contents ·{" "}
          <span data-progress-label aria-hidden="true">
            0%
          </span>
        </p>
        <ol class="list-none border-t-2 border-boulder p-0 pt-[1.2rem]">
          {items.map(({ depth, slug, text }) => (
            <li class={depth === 3 ? "pl-[1.6rem]" : undefined}>
              <a
                href={`#${slug}`}
                data-toc-link
                class={cn(
                  "font-sauce text-[max(13px,1.4rem)] leading-[1.3]",
                  link,
                )}
              >
                {text}
              </a>
            </li>
          ))}
        </ol>
      </nav>

      <details class="mb-[4.8rem] border-t-2 border-boulder pt-[1.6rem] over-tablet:hidden">
        <summary
          class={cn(
            desc12,
            "flex cursor-pointer list-none items-center justify-between text-boulder uppercase [&::-webkit-details-marker]:hidden",
          )}
        >
          Contents
          <span aria-hidden="true">+</span>
        </summary>
        <ol class="mt-[1.2rem] list-none p-0">
          {items.map(({ depth, slug, text }) => (
            <li class={depth === 3 ? "pl-[1.6rem]" : undefined}>
              <a
                href={`#${slug}`}
                data-toc-link
                class={cn("font-sauce text-[15px] leading-[1.3]", link)}
              >
                {text}
              </a>
            </li>
          ))}
        </ol>
      </details>
    </>
  )
}
