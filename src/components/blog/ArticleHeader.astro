---
import { Image } from "astro:assets";
import { postNumber, readingTime, slugifyTag, type Post } from "../../lib/blog";
import { buttonClass, desc12, desc16, paddingHome } from "../../utils/classes";
import { cn } from "../../utils/cn";
import { formatDate } from "../../utils/date";
import ButtonLabel from "../atoms/ButtonLabel.astro";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, tags, sample, cover, coverAlt } = post.data;
---

<header class={cn(paddingHome, "mb-[9.6rem] phone:mb-[6.4rem]")}>
  <p class={cn(desc12, "mb-[3.2rem] text-boulder uppercase phone:mb-[2.4rem]")}>
    <a
      href="/blog"
      class="transition-colors duration-300 fine:hover:text-gold"
    >
      Journal
    </a>{" "}
    / {postNumber(post.number)}
  </p>

  <h1
    class="article__title font-bebas text-[16rem] leading-[0.95] tracking-[-0.025em] text-balance text-boulder uppercase phone:text-[64px]"
  >
    {title}
  </h1>

  <div
    class="article__meta mt-[4.8rem] flex flex-wrap items-start justify-between gap-x-[4rem] gap-y-[2.4rem] phone:mt-[3.2rem]"
  >
    <p
      class={cn(
        desc16,
        "max-w-[max(40rem,300px)] text-[max(18px,2rem)] leading-[1.4] text-pretty text-ash phone:max-w-[255px] phone:ml-auto",
      )}
    >
      {description}
    </p>

    <div class="flex flex-col gap-[1.6rem] phone:ml-auto phone:w-full phone:max-w-[255px]">
      <p class={cn(desc12, "leading-[1.5] text-boulder uppercase")}>
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time> · {
          readingTime(post.body)
        } MIN READ
        {
          updatedDate && (
            <>
              <br />
              Updated{" "}
              <time datetime={updatedDate.toISOString()}>
                {formatDate(updatedDate)}
              </time>
            </>
          )
        }
        {
          sample && (
            <>
              <br />
              Sample post
            </>
          )
        }
      </p>
      <ul class="flex list-none flex-wrap gap-[0.8rem] p-0">
        {
          tags.map((tag) => (
            <li>
              <a href={`/blog?tag=${slugifyTag(tag)}`} class={buttonClass}>
                <ButtonLabel text={tag} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  {
    cover && (
      <Image
        src={cover}
        inferSize
        alt={coverAlt ?? ""}
        widths={[480, 960, 1440]}
        sizes="100vw"
        format="webp"
        loading="eager"
        class="mt-[6.4rem] aspect-[16/9] w-full object-cover"
      />
    )
  }
</header>
