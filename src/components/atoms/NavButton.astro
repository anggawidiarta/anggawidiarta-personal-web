---
import { buttonClass } from "../../utils/classes";
import { cn } from "../../utils/cn";
import ButtonLabel from "./ButtonLabel.astro";

interface Props {
  text: string;
  href?: string;
  className?: string;
}

const { text, href, className = "" } = Astro.props;
const classes = cn(buttonClass, "nav__button shrink-0 grow-0", className);
---

{
  href ? (
    <a href={href} target="_blank" rel="noopener noreferrer" class={classes} nav-anim>
      <ButtonLabel text={text} />
    </a>
  ) : (
    <button class={classes} nav-anim>
      <ButtonLabel text={text} />
    </button>
  )
}
