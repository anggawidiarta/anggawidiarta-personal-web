---
import { buttonClass } from "../../utils/classes";
import { cn } from "../../utils/cn";
import ButtonLabel from "./ButtonLabel.astro";

interface Props {
  text: string;
  href?: string;
  className?: string;
}

const { text, className = "" } = Astro.props;
---

<button class={cn(buttonClass, "nav__button shrink-0 grow-0", className)} nav-anim>
  <ButtonLabel text={text} />
</button>
