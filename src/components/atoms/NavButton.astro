---
import { buttonClass } from "../../utils/classes";
import { cn } from "../../utils/cn";
import ButtonLabel from "./ButtonLabel.astro";

interface Props {
  text: string;
  href?: string;
  className?: string;
  ariaLabel?: string;
}

const { text, href, className = "", ariaLabel } = Astro.props;
const external = href?.startsWith("http") ?? false;
const classes = cn(buttonClass, "shrink-0 grow-0", className);
---

{
  href ? (
    <a
      href={href}
      target={external ? "_blank" : undefined}
      rel={external ? "noopener noreferrer" : undefined}
      aria-label={ariaLabel}
      class={classes}
    >
      <ButtonLabel text={text} />
    </a>
  ) : (
    <button class={classes}>
      <ButtonLabel text={text} />
    </button>
  )
}
