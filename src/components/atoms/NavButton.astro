---
import { buttonClass } from "../../utils/classes";
import { cn } from "../../utils/cn";
import ButtonLabel from "./ButtonLabel.astro";

interface Props {
  text: string;
  href?: string;
  className?: string;
  /** Needed when the visible text alone does not say where the link goes. */
  ariaLabel?: string;
}

const { text, href, className = "", ariaLabel } = Astro.props;
const external = href?.startsWith("http") ?? false;
const classes = cn(
  buttonClass,
  "nav__button shrink-0 grow-0",
  className,
);
---

{
  href ? (
    <a
      href={href}
      target={external ? "_blank" : undefined}
      rel={external ? "noopener noreferrer" : undefined}
      aria-label={ariaLabel}
      class={classes}
      nav-anim
    >
      <ButtonLabel text={text} />
    </a>
  ) : (
    <button class={classes} nav-anim>
      <ButtonLabel text={text} />
    </button>
  )
}
