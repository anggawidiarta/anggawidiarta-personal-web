---
import { desc16, desc32 } from "../../utils/classes";
import { cn } from "../../utils/cn";

interface Props {
  email: string;
}

const { email } = Astro.props;
---

<div
  class="pt-[4.8rem] pb-[7.2rem] text-center phone:ml-auto phone:w-full phone:max-w-[255px] phone:text-left phone:[word-break:break-word]"
>
  <button
    class={cn(
      desc32,
      "email peer/email mb-[1.6rem] cursor-pointer border-0 bg-transparent p-0 font-medium text-ash tablet:text-left fine:hover:text-gold"
    )}
  >
    {email}
  </button>
  <div
    class={cn(
      desc16,
      "to-copy hidden fine:block fine:translate-y-full fine:opacity-0 fine:transition-[opacity,translate] fine:duration-300 fine:peer-hover/email:translate-y-0 fine:peer-hover/email:opacity-100 fine:peer-focus-visible/email:translate-y-0 fine:peer-focus-visible/email:opacity-100 data-[copied]:block data-[copied]:translate-y-0 data-[copied]:opacity-100"
    )}
    role="status"
  >
    <span
      class="rounded-[45px] border-2 border-boulder px-[8px] py-[5px] capitalize"
      >Click To Copy</span
    >
  </div>
</div>

<script>
  const emailButton = document.querySelector<HTMLButtonElement>("button.email");
  const hint = document.querySelector<HTMLElement>(".to-copy");
  const hintLabel = hint?.querySelector("span");
  const idleLabel = hintLabel?.textContent ?? "";
  let resetTimer: number | undefined;

  const showHint = (label: string) => {
    if (!hint || !hintLabel) return;
    hintLabel.textContent = label;
    hint.setAttribute("data-copied", "");
    clearTimeout(resetTimer);
    resetTimer = window.setTimeout(() => {
      hint.removeAttribute("data-copied");
      hintLabel.textContent = idleLabel;
    }, 2000);
  };

  emailButton?.addEventListener("click", async () => {
    const email = emailButton.textContent?.trim();
    if (!email) return;
    try {
      await navigator.clipboard.writeText(email);
      showHint("Copied");
    } catch {
      showHint("Copy failed");
    }
  });
</script>
