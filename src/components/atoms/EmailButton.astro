---
import type { EmailButtonProps } from "../../types/contact";
import { desc16, desc32 } from "../../utils/classes";
import { cn } from "../../utils/cn";

interface Props extends EmailButtonProps {}

const { email } = Astro.props;
---

<div
  class="pt-[4.8rem] pb-[7.2rem] text-center phone:ml-auto phone:w-full phone:max-w-[255px] phone:text-left phone:[word-break:break-word]"
>
  <button
    class={cn(
      desc32,
      "email peer/email mb-[1.6rem] cursor-pointer border-0 bg-transparent p-0 font-medium text-ash tablet:text-left fine:hover:text-gold"
    )}
  >
    {email}
  </button>
  <div
    class={cn(
      desc16,
      "to-copy hidden fine:block fine:translate-y-full fine:uppercase fine:opacity-0 fine:transition-[opacity,translate] fine:duration-300 fine:peer-hover/email:translate-y-0 fine:peer-hover/email:opacity-100"
    )}
  >
    <span
      class="rounded-[45px] border-2 border-boulder px-[8px] py-[5px] capitalize"
      >Click To Copy</span
    >
  </div>
</div>

<script>
  import { playClickSound } from "../../js/utils/sound";

  const emailButton = document.querySelector("button.email");
  emailButton?.addEventListener("click", async () => {
    const email = emailButton.textContent;
    if (email) {
      try {
        await navigator.clipboard.writeText(email);

        playClickSound();
      } catch (err) {
        console.error("Failed to copy:", err);
        alert("Failed to copy email");
      }
    }
  });
</script>
