---
import { desc12 } from "../../utils/classes";
import { cn } from "../../utils/cn";

interface Props {
  category: string;
  technology: string;
}

const { category, technology } = Astro.props;
---

<div
  class={cn(
    desc12,
    "mt-[3.2rem] flex justify-end pr-[2.2rem] over-tablet:pr-[17.2rem]"
  )}
>
  <div>
    <p class="transition-colors duration-300 group-hover/project:text-ash">
      {category} / <br />
      {technology}
    </p>
  </div>
</div>
