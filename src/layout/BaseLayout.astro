---
import HeaderPage from "../components/HeaderPage.astro";
import Preloader from "../components/Preloader.astro";
---

<!doctype html>
<html
  lang="en"
  class="overscroll-none text-[length:calc(100vw/1440*10)] antialiased [scrollbar-width:none] max-[375px]:text-[length:calc(100vw/375*10)] phone:text-[length:calc(100vw/550*10)]"
>
  <HeaderPage
    title="Angga Widiarta - Web Developer"
    contentDesc="Front End Developer Based In Lombok, Indonesia. Brimming With Enthusiasm And An Unwavering Optimism For Continuous Growth And Development"
  />

  <body
    class="h-screen min-h-screen overflow-hidden bg-ink font-sauce text-[1.6rem] leading-none font-medium text-ash [scrollbar-width:none]"
  >
    <Preloader />

    <slot />

    <script>
      import "../js/index";
    </script>
  </body>
</html>
