---
import Toaster from "../components/studio/Toaster.astro";
import { desc12, paddingHome } from "../utils/classes";
import { cn } from "../utils/cn";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title?: string;
}

const { title = "Studio" } = Astro.props;
---

<BaseLayout
  title={`${title} — Angga Widiarta`}
  description="Private area."
  noindex
>
  <main class={cn(paddingHome, "min-h-screen py-[2rem]")}>
    <header
      class={cn(desc12, "mb-[6.4rem] flex items-center justify-between uppercase")}
    >
      <a
        href="/"
        class="text-boulder transition-colors duration-300 fine:hover:text-gold"
        >Back to portfolio</a
      >
      <slot name="actions" />
    </header>

    <slot />
  </main>
  <Toaster />
</BaseLayout>
