---
import BaseLayout from "../layout/BaseLayout.astro";
import Certifications from "../components/Certifications.astro";
import FooterPage from "../components/FooterPage.astro";
import { TextGenerateEffectDemo } from "../components/TextGenerateEffect";
import ArrowDown from "../components/atoms/ArrowDown.astro";
import HeroLetters from "../components/atoms/HeroLetters.astro";
import ContactSection from "../components/organisms/ContactSection.astro";
import Navigation from "../components/organisms/Navigation.astro";
import PinProjectsSection from "../components/templates/PinProjectsSection.astro";
import ProjectsSection from "../components/templates/ProjectsSection.astro";
import { desc12, desc16, paddingHome, title328 } from "../utils/classes";
import { cn } from "../utils/cn";

const bigTitle = cn(title328, "tracking-[-0.105em]");
const dash = cn(
  bigTitle,
  "hero__title__dash inline-block [transform:scaleX(1.05)] will-change-transform",
);
---

<BaseLayout>
  <main
    class="home invisible py-[2rem] [--animate-delay:2s] [--animate-duration:2.5s] [scrollbar-width:none]"
  >
    <Navigation />

    <section class={cn("mb-[9.6rem]", paddingHome)}>
      <div class="hero__title leading-[0.9] text-boulder">
        <h1
          class={cn(
            title328,
            "mobile tracking-[-0.05em] break-words over-phone:hidden",
          )}
        >
          FRONT <br />
          —— END <br />
          DEVELOPER
        </h1>
        <h1
          class="overflow inline-flex w-full justify-between overflow-hidden pr-[3rem] phone:hidden"
        >
          <div class="flex w-full justify-between pr-[3rem]" title-overflow>
            <span
              class={bigTitle + " inline-block"}
              data-parallax-x="7"
              data-parallax-start="top"
            >
              <HeroLetters word="FRONT" />
            </span>
            <span class={cn(dash, "desktop tablet:hidden")}>——</span>
            <span class={cn(dash, "tablet over-tablet:hidden")}>——</span>

            <span
              class={bigTitle + " inline-block"}
              data-parallax-x="-7"
              data-parallax-start="top"
            >
              <HeroLetters word="END" />
            </span>
          </div>
        </h1>

        <span
          class="overflow inline-flex w-full justify-between overflow-hidden"
        >
          <div class="w-full justify-between over-tablet:flex">
            <h1 class={cn(bigTitle, "shrink-0 phone:hidden")} title-overflow>
              <HeroLetters word="DEVELOPER" />
            </h1>
            <div
              class={cn(
                desc16,
                "bottom__right relative z-1 flex w-full max-w-[32.5rem] flex-col pt-[2rem] pb-[5rem] tablet:max-w-[55rem] tablet:pb-0 phone:ml-auto phone:max-w-[255px]",
              )}
            >
              <div class="text-ash [&_span]:uppercase">
                <span class={cn(desc12, "text-boulder")}>About</span>
                <span class="md:hidden">
                  &nbsp; i am a Web developer & Data Enthusiast based in Lombok,
                  Indonesia, driven by a relentless pursuit of innovation and
                  continuous growth.</span
                >
                <TextGenerateEffectDemo
                  className="max-md:hidden"
                  words={"i am a Web developer & Data Enthusiast based in Lombok, Indonesia, driven by a relentless pursuit of innovation and continuous growth."}
                  client:load
                />
              </div>
              <div
                class="mt-auto flex items-center justify-between text-boulder tablet:hidden"
              >
                <p class="capitalize">Scroll Down</p>
                <span
                  class="relative z-1 inline-flex items-center overflow-hidden"
                >
                  <span
                    class="flex animate-infinite-arrow [transform:translateY(-100%)]"
                  >
                    <span><ArrowDown /></span>
                    <span class="absolute top-full"><ArrowDown /></span>
                  </span>
                </span>
              </div>
            </div>
          </div>
        </span>
      </div>
    </section>

    <ProjectsSection />

    <PinProjectsSection />

    <Certifications />

    <ContactSection />

    <FooterPage />
  </main>
</BaseLayout>
