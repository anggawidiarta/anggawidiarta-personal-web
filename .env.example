# Supabase project "Blog". Publishable values only; never commit a service-role key.
PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: Vercel Deploy Hook URL (Project Settings > Git > Deploy Hooks). Publishing
# triggers a rebuild through it; without it the Studio says the rebuild was skipped.
VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/prj_w8tOQcU70THjTDiDOKfYbxEIK5v0/v3wXnYSwTB
